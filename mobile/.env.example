# Server origin only (the app adds /api/v1). Plain http is accepted only in a development build and only for
# localhost or a LAN address; release builds require https. Use your computer's LAN IP for a physical phone.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
# The prefix printed in tag QR codes. Same value as the backend's TAG_BASE_URL (it already ends in /t).
EXPO_PUBLIC_TAG_BASE_URL=http://192.168.1.10:8000/t

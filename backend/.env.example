APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wasla
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3700
EXPO_ACCESS_TOKEN=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WASLA
TAG_BASE_URL=http://localhost:8000/t
OPENAI_API_KEY=
MODERATION_DAILY_CAP=5000
# true adds a consent checkbox to visitor chat; visitors who decline get blacklist-only moderation
CHAT_CONSENT_REQUIRED=false
# fake (local only), iyzico or paytr
PAYMENT_GATEWAY=fake
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Sandbox here; production must use https://api.iyzipay.com or leave it unset (ProductionGuard checks).
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Test transactions only. ProductionGuard refuses 1 in production.
PAYTR_TEST_MODE=1
# Version of the distance-selling text shown at renewal; stored on each payment
LEGAL_TEXT_VERSION=1
# Comma separated proxy IPs/CIDRs, or * behind a trusted load balancer only
TRUSTED_PROXIES=
# Comma separated browser origins; empty allows none
CORS_ALLOWED_ORIGINS=
# Version of the privacy notice owners accept at registration
PRIVACY_NOTICE_VERSION=1
# Deep link that opens the mobile reset-password screen
PASSWORD_RESET_URL=wasla://reset-password
